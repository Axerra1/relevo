# Copia a .env y llena. NO comitear .env.
OPENAI_API_KEY=

# Adaptador de canal: pwa | zello
CHANNEL_ADAPTER=pwa
PORT=8787

# --- M6: umbral de peticion sin respuesta ---
# 60000 en operacion real. 20000 para grabar el video sin esperar un minuto en camara.
UNANSWERED_MS=20000

# --- P1 / M7: disciplina de canal ---
MAX_BURST_MS=5000
# P4: presupuesto de transmisiones por hora de canal
MAX_TX_PER_HOUR=2
# M7b: reintentos permitidos por item (1 = un solo reintento)
MAX_RETRIES=1
# Umbral de confianza. Debajo de esto no se transmite nada (P3)
MIN_CONFIDENCE=0.6

# --- Modelos (OpenAI es marquee sponsor del evento) ---
STT_MODEL=gpt-4o-mini-transcribe
EXTRACT_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx

# --- Zello (solo si CHANNEL_ADAPTER=zello) ---
# El nombre del canal, exacto como aparece en la app.
ZELLO_CHANNEL=

# CASO A - red Friends and Family (la app normal de Zello).
# El token sale de developers.zello.com. Usuario y clave son los de tu cuenta;
# sin ellos entras anonimo y solo puedes escuchar, no transmitir.
ZELLO_TOKEN=
ZELLO_USERNAME=
ZELLO_PASSWORD=

# CASO B - Zello Work. Pon el nombre de la red y deja ZELLO_TOKEN vacio.
# La URL se arma como wss://zellowork.io/ws/<red>
ZELLO_NETWORK=

# Solo si necesitas apuntar a otro host de la red Friends and Family.
ZELLO_WS=wss://zello.io/ws
